    {
      "name": "autonomous_navigation",
      "label": "Autonomous navigation",
      "category": "Navigation",
      "description": "Uses 100% base drive, finds and follows walls at 200 mm, then maps the arena in 200 mm parallel sweep lanes. Every completed turn is checked before forward motion: a still-blocked front causes another turn, while a close wall on all three sides triggers a reverse escape. Navigation uses the top TOFs and 8x8 forward view plus left/right ultrasound; bottom TOFs remain weight-sensing only.",
      "action": "navigation_toggle",
      "debug_mode_required": true,
      "args": [],
      "buttons": [
        {"label": "RUN NAVIGATION", "arguments": {"enabled": true}},
        {"label": "STOP NAVIGATION", "arguments": {"enabled": false}}
      ]
    },
    {
      "name": "set_hx12k_angles",
      "label": "Set HX12K servo angles",
      "category": "HX12K",
      "description": "Select any combination of level-shifter outputs and send each selected servo its angle.",
      "action": "hx12k_angles",
      "debug_mode_required": true,
      "args": [
        {"name": "select_a", "label": "Select A (D33)", "type": "bool", "default": false},
        {"name": "angle_a_deg", "label": "A angle", "type": "float", "min": 0, "max": 135, "step": 1, "default": 67.5},
        {"name": "select_b", "label": "Select B (D32)", "type": "bool", "default": false},
        {"name": "angle_b_deg", "label": "B angle", "type": "float", "min": 0, "max": 135, "step": 1, "default": 67.5},
        {"name": "select_c", "label": "Select C (D31)", "type": "bool", "default": false},
        {"name": "angle_c_deg", "label": "C angle", "type": "float", "min": 0, "max": 135, "step": 1, "default": 67.5},
