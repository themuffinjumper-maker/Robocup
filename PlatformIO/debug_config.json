    {"name":"navigation.gap_margin_mm","label":"Gap safety margin","datatype":"int","unit":"mm","value":80,"min":0,"max":500,"step":10},
    {"name":"navigation.gap_depth_mm","label":"Minimum depth considered open","datatype":"int","unit":"mm","value":550,"min":250,"max":3000,"step":25},
    {"name":"navigation.matrix_floor_rows","label":"Ignored lower 8x8 rows","datatype":"int","value":2,"min":0,"max":4,"step":1},
